rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admins upload shared content and manage access. Keep in sync with ADMIN_UIDS in src/config.ts.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'Kj7sPwTCy1hPmbCdtGTfzMDcmTs2',
        'DtLZkRsqIZVVYtzzKkB2NAy4zE22'
      ];
    }

    // Shared official content is open to every signed-in user unless the admin
    // restricts it to invited e-mails (content/access, readable by the admin only).
    function canReadOfficial() {
      let access = get(/databases/$(database)/documents/content/access).data;
      return isAdmin() || (
        request.auth != null && (
          access.restricted == false ||
          (request.auth.token.email_verified == true && request.auth.token.email.lower() in access.invited)
        )
      );
    }

    // Each user may read and write only their own data:
    // characters, history, homebrew packs and settings.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Feedback: anyone signed in can send it (as themselves, status "new"); only admins read and manage it.
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // config/notify: URL of the admin's Apps Script that e-mails new feedback.
    match /config/notify {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /content/access {
      allow read, write: if isAdmin();
    }

    // content/official holds the version and pack list; packs/{part} the data.
    match /content/official {
      allow read: if canReadOfficial();
      allow write: if isAdmin();
    }
    match /content/official/packs/{part} {
      allow read: if canReadOfficial();
      allow write: if isAdmin();
    }
  }
}
