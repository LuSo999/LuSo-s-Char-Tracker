{
  "name": "luso-sheet-tool",
  "productName": "LuSo Sheet Tool",
  "version": "0.3.1",
  "description": "LuSo's Char Tracker on the desktop: the whole web app plus PDF tools (fill any character sheet with AI, read filled sheets into characters).",
  "author": "LuSo999",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "LUSO_WEB_URL=http://localhost:5173/LuSo-s-Char-Tracker/ electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "openai": "^7.57.0"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.luso999.sheettool",
    "productName": "LuSo Sheet Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "LuSo-Sheet-Tool-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-"
    }
  },
  "allowScripts": {
    "electron": true
  }
}
